PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/medzk
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Secrets. Placeholders are accepted for local development only.
# With NODE_ENV=production the server refuses to start unless each is 32+ random characters.
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ISSUER_KEY_SECRET=change-me-to-another-long-random-string

# Session lifetime in minutes (default 120)
JWT_TTL_MINUTES=120

RPC_URL=http://127.0.0.1:8545
# Hardhat local account #1 (public test key - NEVER use on a real network).
# Must match the gateway address set in the contract at deploy time.
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

STORAGE_DIR=storage
MAX_UPLOAD_MB=20
# Uploads that never reached the blockchain are deleted after this long
PENDING_UPLOAD_TTL_MINUTES=60
# Admin dashboard warns when the gateway wallet holds less than this (ETH)
LOW_GATEWAY_BALANCE_ETH=0.01

# NODE_ENV=production
